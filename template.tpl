___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// PromNET Statisztika — loads the cookie-free tracker. The website ID is passed in the URL,
// the script writes it to its own <script> element before reading it.
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const url = 'https://statisztika.promnet.hu/s.js?id=' + encodeUriComponent(data.websiteId);
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, url);


