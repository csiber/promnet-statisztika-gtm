___TESTS___

scenarios:
- name: Injects the tracker with the website ID
  code: |-
    const mockData = { websiteId: '0f8b3c2e-1a2b-4c3d-8e9f-0a1b2c3d4e5f' };
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    runCode(mockData);
    assertThat(injected).isEqualTo('https://statisztika.promnet.hu/s.js?id=0f8b3c2e-1a2b-4c3d-8e9f-0a1b2c3d4e5f');
    assertApi('gtmOnSuccess').wasCalled();


